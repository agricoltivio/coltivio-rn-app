{
  "name": "coltivio",
  "version": "1.0.3",
  "description": "Open-source farm management app built with React Native and Expo",
  "repository": {
    "type": "git",
    "url": "https://github.com/agricoltivio/coltivio-rn-app.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Coltivio",
  "homepage": "https://github.com/agricoltivio/coltivio-rn-app",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest --watchAll",
    "test:ci": "jest --ci --no-coverage --forceExit",
    "lint": "expo lint .",
    "lint:fix": "expo lint . --fix",
    "lint:ci": "expo lint . --no-cache",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json}\" --ignore-path .gitignore",
    "typecheck": "tsc --noEmit && cd scripts && tsc --noEmit",
    "generate:api-types": "npx openapi-typescript ./openapi.json -o ./api/v1.d.ts",
    "eas:build-sim": "eas build -p ios --profile development-simulator",
    "eas:build-dev-ios": "eas build --profile development --platform ios",
    "eas:build-preview-ios": "eas build --profile preview --platform ios",
    "eas:build-dev-android": "APP_VARIANT=development eas build --profile development --platform android",
    "eas:install": "eas build:run -p ios",
    "expo:update": "yarn expo install expo@latest && npx expo install --fix",
    "eas:build-production": "eas build --profile production --platform all",
    "eas:submit-ios": "eas submit --platform ios --latest",
    "eas:submit-android": "eas submit --platform android --latest"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "expo": {
    "install": {
      "exclude": ["@sentry/react-native"]
    }
  },
  "dependencies": {
    "@10play/tentap-editor": "^1.0.1",
    "@dagrejs/dagre": "^3.0.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5",
    "@gorhom/portal": "^1.0.14",
    "@lukemorales/query-key-factory": "^1.3.4",
    "@maplibre/maplibre-react-native": "^11.4.0",
    "@miblanchard/react-native-slider": "^2.6.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-google-signin/google-signin": "^13.2.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/elements": "^2.1.1",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.11.0",
    "@sentry/react-native": "^8.28.0",
    "@shopify/react-native-skia": "2.6.2",
    "@stripe/stripe-react-native": "0.64.0",
    "@supabase/supabase-js": "^2.49.4",
    "@tanstack/query-core": "^5.73.3",
    "@tanstack/react-query": "^5.59.19",
    "@turf/turf": "^7.1.0",
    "@types/marked": "^6.0.0",
    "@uidotdev/usehooks": "^2.4.1",
    "date-fns": "^4.1.0",
    "expo": "^57.0.25",
    "expo-apple-authentication": "~57.0.2",
    "expo-auth-session": "~57.0.13",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-loader": "~57.0.1",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "fuse.js": "^7.0.0",
    "i18next": "^23.16.5",
    "lodash": "^4.17.21",
    "marked": "^17.0.4",
    "node-html-markdown": "^2.0.0",
    "openapi-fetch": "^0.13.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.53.2",
    "react-i18next": "^15.1.1",
    "react-native": "0.86.3",
    "react-native-element-dropdown": "^2.12.4",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-gifted-charts": "^1.4.47",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-markdown-display": "^7.0.2",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "styled-components": "^6.1.13",
    "victory-native": "^41.26.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-native/jest-preset": "^0.86.3",
    "@types/dagre": "^0.7.54",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.13",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "^18.0.7",
    "baseline-browser-mapping": "^2.9.19",
    "eslint": "^9.14.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.2.1",
    "jest-expo": "~57.0.5",
    "openapi-typescript": "^7.4.3",
    "prettier": "^3.3.3",
    "react-test-renderer": "18.2.0",
    "typescript": "~6.0.3"
  }
}
