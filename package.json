{
  "name": "coltivio",
  "version": "1.0.3",
  "description": "Open-source farm management app built with React Native and Expo",
  "repository": {
    "type": "git",
    "url": "https://github.com/agricoltivio/coltivio-rn-app.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Coltivio",
  "homepage": "https://github.com/agricoltivio/coltivio-rn-app",
  "resolutions": {
    "markdown-it": "^14.3.3",
    "prosemirror-view": "^1.42.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest --watchAll",
    "test:ci": "jest --ci --no-coverage --forceExit",
    "lint": "eslint . --cache --cache-location .expo/cache/eslint/",
    "lint:fix": "expo lint --fix",
    "lint:ci": "eslint .",
    "i18n:unused": "node scripts/find-unused-translation-keys.js",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json}\" --ignore-path .gitignore",
    "typecheck": "tsc --noEmit && cd scripts && tsc --noEmit",
    "generate:api-types": "npx openapi-typescript ./openapi.json -o ./api/v1.d.ts && prettier --write ./api/v1.d.ts ./openapi.json",
    "release:prepare": "node scripts/prepare-release.js",
    "eas:build-sim": "eas build -p ios --profile development-simulator",
    "eas:build-dev-ios": "eas build --profile development --platform ios",
    "eas:build-preview-ios": "eas build --profile preview --platform ios",
    "eas:build-dev-android": "eas build --profile development --platform android",
    "eas:install": "eas build:run -p ios",
    "expo:update": "yarn expo install expo@latest && npx expo install --fix",
    "eas:build-production": "eas build --profile production --platform all",
    "eas:build-production-apk": "eas build --profile production-apk --platform android",
    "eas:submit-ios": "eas submit --platform ios --latest",
    "eas:submit-android": "eas submit --platform android --latest",
    "prepare": "husky"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@10play/tentap-editor": "^1.1.0",
    "@dagrejs/dagre": "^3.0.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5",
    "@gorhom/portal": "^1.0.14",
    "@lukemorales/query-key-factory": "^1.3.4",
    "@maplibre/maplibre-react-native": "11.5.1",
    "@miblanchard/react-native-slider": "^2.6.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-google-signin/google-signin": "^13.2.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/elements": "^2.1.1",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.11.0",
    "@sentry/react-native": "^8.1.0",
    "@stripe/stripe-react-native": "0.82.0",
    "@supabase/supabase-js": "^2.49.4",
    "@tanstack/query-core": "^5.73.3",
    "@tanstack/react-query": "^5.59.19",
    "@turf/turf": "^7.1.0",
    "@types/marked": "^6.0.0",
    "@uidotdev/usehooks": "^2.4.1",
    "date-fns": "^4.1.0",
    "expo": "~58.0.26",
    "expo-apple-authentication": "~58.0.3",
    "expo-application": "~58.1.2",
    "expo-auth-session": "~58.0.19",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-image": "~58.0.18",
    "expo-image-loader": "~58.0.3",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.22",
    "expo-notifications": "~58.1.9",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "fuse.js": "^7.0.0",
    "i18next": "^23.16.5",
    "lodash": "^4.17.21",
    "marked": "^17.0.4",
    "node-html-markdown": "^2.0.0",
    "openapi-fetch": "^0.13.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.53.2",
    "react-i18next": "^15.1.1",
    "react-native": "0.88.1",
    "react-native-element-dropdown": "^2.12.4",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-gifted-charts": "^1.4.47",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-markdown-display": "^7.0.2",
    "react-native-pager-view": "9.0.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-skia": "~2.15.5",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "styled-components": "^6.1.13",
    "turf": "^3.0.14",
    "victory-native": "43.1.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-native/jest-preset": "~0.88.1",
    "@types/dagre": "^0.7.54",
    "@types/jest": "30.0.0",
    "@types/lodash": "^4.17.13",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^18.0.7",
    "baseline-browser-mapping": "^2.9.19",
    "eslint": "^9.14.0",
    "eslint-config-expo": "~10.0.0",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "lint-staged": "^16.4.0",
    "openapi-typescript": "^7.4.3",
    "prettier": "^3.3.3",
    "react-test-renderer": "18.2.0",
    "typescript": "5.9.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native",
        "@stripe/stripe-react-native",
        "typescript",
        "eslint-config-expo"
      ]
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": "prettier --write"
  }
}
